# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for current tool-calling models.
# qwen3 makes parallel tool calls (fewer turns = fewer tokens on the 8k TPM free tier).
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# Optional but strongly recommended: unauthenticated GitHub API is limited to 60 req/hour
GITHUB_TOKEN=
NEATLOGS_API_KEY=

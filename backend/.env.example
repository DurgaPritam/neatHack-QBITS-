# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for current tool-calling models.
# qwen3 makes parallel tool calls (fewer turns = fewer tokens on the 8k TPM free tier).
# Ordered list to rotate across; Groq limits are per model (8k TPM, 1k RPD, 200k TPD each on free tier)
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
# Used only if GROQ_MODELS is empty
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# Optional but strongly recommended: unauthenticated GitHub API is limited to 60 req/hour
GITHUB_TOKEN=
NEATLOGS_API_KEY=
# 1 = let the quick phase spend a second LLM call rewriting a rejected roast (~+1.5k tokens)
QUICK_ROAST_REWRITE=0
# live | record (save responses to fixtures/llm) | replay (no LLM network; answers from fixtures)
LLM_MODE=live
# Models allowed to extract and judge claims; deep audits wait for these instead of degrading
JUDGE_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
# Share of each model's daily tokens that only admin requests (X-Admin-Token header) may use
BUDGET_RESERVE_PCT=25
# Random secret for demo/eval runs: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
# Absolute URLs used in share links / Open Graph tags
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Abuse protection (per client IP, in memory). Admin-token requests are exempt.
RATE_AUDITS_PER_10MIN=5
RATE_DEEP_PER_HOUR=3
# Deep checks waiting or running; beyond this, new requests get a friendly "queue full"
DEEP_QUEUE_MAX=10
# Same repo audited again within this many seconds: hand back the recent audit
REPO_COOLDOWN_S=600
